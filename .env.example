# DML connection — application reads/writes (must NOT hold DDL privileges in production)
DATABASE_URL=postgresql+asyncpg://dodoo_user:changeme@localhost/dodoo_dev

# DDL connection — schema migrations only (holds CREATE/ALTER TABLE privileges)
DATABASE_MIGRATION_URL=postgresql+asyncpg://dodoo_admin:changeme@localhost/dodoo_dev

# Session expiry in hours
SESSION_EXPIRY_HOURS=8

# Colon-separated list of add-on directories
ADDONS_PATH=./addons

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
